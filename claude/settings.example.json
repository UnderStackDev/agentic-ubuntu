  },
  "extraKnownMarketplaces": {
    "agentic-ubuntu": {
      "source": {
        "source": "directory",
        "path": "/home/YOU/Projects/agentic-ubuntu/plugins"
      }
    }
  },
  "enabledPlugins": {
    "selkea@agentic-ubuntu": true
  }
}
