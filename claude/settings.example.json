{
  "cleanupPeriodDays": 36500,
  "env": {
    "SUDO_ASKPASS": "/home/YOU/.local/bin/sudo-askpass"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.local/share/ghostex/hooks/agent-statusline.sh",
    "padding": 0
  },
  "theme": "dark",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='claude' ~/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/Projects/gnome_plugin_agents/bin/claude-state-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='claude' ~/.local/share/ghostex/hooks/agent-shell-notify.sh",
